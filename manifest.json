{
  "manifest_version": 3,
  "name": "Google Extension Pro Toolkit",
  "version": "1.2.2",
  "description": "Chrome extension toolkit for promotional offer token injection and checkout price safety verification on Google One AI Pro.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://one.google.com/*",
    "https://tokenized.play.google.com/*",
    "https://play.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Extension Pro Toolkit"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://one.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://one.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://tokenized.play.google.com/*"],
      "js": ["play_guard.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
